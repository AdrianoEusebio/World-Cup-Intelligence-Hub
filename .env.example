# Configurações do Banco de Dados PostgreSQL (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worldcup
DB_USER=postgres
DB_PASSWORD=suasenha_aqui

# Integração com LLM (Qualquer provedor compatível com OpenAI)
# Se deixada vazia, a aplicação ativará o MockLLMClient automaticamente.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Configurações de Ambiente
ENVIRONMENT=development
